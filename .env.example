# DebridPulse — environment variables

# Timezone
TZ=Etc/UTC

# Optional canonical externally reachable HTTPS origin.
# Recommended when DebridPulse is exposed through a reverse proxy.
# Used for browser origin validation, secure-cookie classification, and OIDC callbacks.
# This environment value overrides the persisted Authentication-menu value.
# PUBLIC_BASE_URL=https://download.example.com
